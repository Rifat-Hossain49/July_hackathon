# Copy to /etc/shongket-hub.env and replace the example origin.
# This file contains configuration, not application secrets.
SHONGKET_HUB_DB=/var/lib/shongket-hub/hub.sqlite3
SHONGKET_HUB_ORIGIN=https://shongket.example.bd
SHONGKET_HUB_TRUSTED_PROXY=127.0.0.1
SHONGKET_HUB_MAX_ACTIVE=10000
SHONGKET_HUB_MAX_PER_CHANNEL=1000
SHONGKET_HUB_MAX_DB_BYTES=67108864
SHONGKET_HUB_CLEANUP_BATCH=500
SHONGKET_HUB_PUBLISH_PER_MINUTE=12
